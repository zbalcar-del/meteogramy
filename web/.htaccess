DirectoryIndex index.html

# Stránky, které vykresluje aplikace v index.html (stejné jako APP_ROUTES v meteogram/server.py)
RewriteEngine On
RewriteRule ^(o-projektu|ochrana-soukromi)/?$ /index.html [L]

# data se mění s každým během modelu
<FilesMatch "\.json$">
  Header set Cache-Control "no-cache"
</FilesMatch>
