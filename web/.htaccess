DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# jedna adresa webu: https://meteogramy.cz (hosting může HTTPS ukončovat na proxy, proto i X-Forwarded-Proto)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://meteogramy.cz%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://meteogramy.cz%{REQUEST_URI} [R=301,L]

# otisky souborů pro nasazování nejsou veřejné
RewriteRule ^\.deploy-manifest - [F,L]

# Stránky stanic, pohoří a informační stránky jsou vygenerované složky (meteogram/build_pages.py).

# data se mění s každým během modelu
<FilesMatch "\.json$">
  Header set Cache-Control "no-cache"
</FilesMatch>

# Fragment je určený pro aplikaci; vyhledávače indexují samostatnou stránku.
<Files "snow-fragment.html">
  Header set Cache-Control "no-cache"
  Header set X-Robots-Tag "noindex"
</Files>

<Files "avalanche-fragment.html">
  Header set Cache-Control "no-cache"
  Header set X-Robots-Tag "noindex"
</Files>
